# dsynco-gui v0.1

menu mfile {
	* "Diff: Ignore Date"				A_DIFF_NO_DATE
	* "Diff: Move: Ignore Name"			A_DIFF_MOVE_NO_NAME
	- "Scan and Compare"				A_SCAN_CMP		"F5"
	- "Scan for Possible Duplicates"	A_SCAN_DUP		"Ctrl+F5"
	- -
	- "Synchronize Selected"			A_SYNC		"F6"
	- "Replace Date for Selected"		A_SYNC_DATE	"Ctrl+D"
	* "Sync: Delete Files: On/Off"		A_SYNC_FDEL
	- -
	- "Swap Source and Target"			A_SWAP		"Ctrl+W"
	- "New Window"						A_WND_NEW	"Ctrl+N"
	- "E_xit"							A_QUIT		"Ctrl+Q"
}

menu mlist {
	- "Select All"				A_SEL_ALL	"Ctrl+A"
	- "Sort by Size"			A_SORT_FILESIZE
	- "Sort by Date"			A_SORT_FILEDATE
	* "Filter: Include: Both"	A_SHOW_INC_BOTH
}

menu mpopup {
	- "Source: Exec"			A_SRC_EXEC		"Ctrl+X"
	- "Source: Show Directory"	A_SRC_SHOW_DIR	"Ctrl+E"
	- "Source: Delete Selected"	A_SRC_DELETE	"Delete"
	- -
	- "Target: Exec"			A_DST_EXEC		"Ctrl+Shift+X"
	- "Target: Show Directory"	A_DST_SHOW_DIR	"Ctrl+Shift+E"
	- "Target: Delete Selected"	A_DST_DELETE	"Shift+Delete"
	- -
	- "Filter by Name"	A_FILTER_NAME
}

window wmain {
	title		"dsynco gsync"
	position	0 0 600 600
	icon {
		%IF_WIN32
		resource 2
		%ENDIF
		%IF_GTK
		filename "dsynco.svg"
		%ENDIF
	}

	mainmenu mmenu {
		item "_File" {
			submenu mfile
		}
		item "_List" {
			submenu mlist
		}
	}

	label llpath {
		style	horizontal
		text	"Source Dir:"
	}
	editbox lpath {
	}

	label lrpath {
		style	horizontal
		text	"Target Dir:"
	}
	editbox rpath {
	}

	label linclude {
		style	horizontal
		text	"Include:"
	}
	editbox include {
		onchange	A_INCLUDE_CHANGE
	}

	label lexclude {
		style	horizontal
		text	"Exclude:"
	}
	editbox exclude {
		onchange	A_EXCLUDE_CHANGE
	}

	label ldays {
		style	horizontal
		text	"Recent days:"
	}
	editbox recent_days {
		onchange	A_RECENTDAYS_CHANGE
	}

	checkbox show_left {
		text	"LEFT"
		style	horizontal
		action	A_SHOW_LEFT
	}

	checkbox show_eq {
		text	"EQ"
		style	horizontal
		action	A_SHOW_EQ
	}

	checkbox show_neq {
		text	"NEQ"
		style	horizontal
		action	A_SHOW_NEQ
	}

	checkbox show_mov {
		text	"MOV"
		style	horizontal
		action	A_SHOW_MOV
	}

	checkbox show_right {
		text	"RIGHT"
		style	horizontal
		action	A_SHOW_RIGHT
	}

	checkbox show_done {
		text	"DONE"
		style	horizontal
		action	A_SHOW_DONE
	}

	checkbox show_neq_date {
		text	"NEQ DATE"
		action	A_SHOW_NEQ_DATE
	}

	listview view {
		style		grid_lines multi_select
		popup_menu	mpopup

		column "Status" {
		}
		column "Source Dir" {
		}
		column "Source File" {
		}
		column "Target Dir" {
		}
		column "Target File" {
		}
		column "Source Size" {
		}
		column "Target Size" {
		}
		column "Source Date" {
		}
		column "Target Date" {
		}
	}

	statusbar stbar {
	}
}
